function showSection(sectionId) {
    const titlePage = document.getElementById('title-page');
    const repository = document.getElementById('main-repository');
    const navs = document.querySelectorAll('.nav-group');
    const sections = document.querySelectorAll('main section');
    const selectedNav = document.getElementById('nav-' + sectionId);
    const selectedSection = document.getElementById('section-' + sectionId);

    titlePage.style.display = 'none';
    repository.style.display = 'block';

    navs.forEach(nav => {
        nav.style.display = 'none';
    });

    sections.forEach(section => {
        section.classList.remove('active');
    });

    if (selectedNav) {
        selectedNav.style.display = 'block';
    }

    if (selectedSection) {
        selectedSection.classList.add('active');
    }

    window.scrollTo(0, 0);
    updateActiveNav();

    if (sectionId === 'patricio') {
        window.setTimeout(() => {
            updateJuanPatricioSliders();
            loadStoryMapOnce();
        }, 150);
    }
}

function goHome() {
    document.getElementById('title-page').style.display = 'flex';
    document.getElementById('main-repository').style.display = 'none';
    window.scrollTo(0, 0);
}

/* Keep the left rail useful as orientation, not just navigation. */
function updateActiveNav() {
    const activeSection = document.querySelector('main section.active');
    if (!activeSection) return;

    const sectionId = activeSection.id.replace('section-', '');
    const nav = document.getElementById('nav-' + sectionId);
    if (!nav) return;

    const links = Array.from(nav.querySelectorAll('a[href^="#"]'));
    if (!links.length) return;

    const offset = window.innerWidth <= 900 ? 155 : 190;
    let currentLink = links[0];

    links.forEach(link => {
        const target = document.querySelector(link.getAttribute('href'));
        if (!target) return;

        if (target.getBoundingClientRect().top <= offset) {
            currentLink = link;
        }
    });

    links.forEach(link => {
        link.classList.toggle('active', link === currentLink);
    });
}

let navTicking = false;
window.addEventListener('scroll', () => {
    if (navTicking) return;
    navTicking = true;

    window.requestAnimationFrame(() => {
        updateActiveNav();
        navTicking = false;
    });
}, { passive: true });

/* Juan Patricio historical / modern map slider */
function updateJuanPatricioSliders() {
    const sliders = document.querySelectorAll('#section-patricio .comparison-slider');

    sliders.forEach(slider => {
        const range = slider.querySelector('.comparison-range');
        const leftLayer = slider.querySelector('.comparison-left-layer');
        const leftImage = slider.querySelector('.comparison-image-left');
        const divider = slider.querySelector('.comparison-divider');

        if (!range || !leftLayer || !leftImage || !divider) return;

        const position = Number(range.value || 50);
        const sliderWidth = slider.clientWidth;
        const sliderHeight = slider.clientHeight;

        leftLayer.style.width = position + '%';
        divider.style.left = position + '%';

        if (sliderWidth > 0) {
            leftImage.style.width = sliderWidth + 'px';
        }

        if (sliderHeight > 0) {
            leftImage.style.height = sliderHeight + 'px';
        }
    });
}

function initializeJuanPatricioSliders() {
    const sliders = document.querySelectorAll('#section-patricio .comparison-slider');

    sliders.forEach(slider => {
        const range = slider.querySelector('.comparison-range');
        if (!range || range.dataset.sliderInitialized === 'true') return;

        range.dataset.sliderInitialized = 'true';
        range.addEventListener('input', updateJuanPatricioSliders);
        range.addEventListener('change', updateJuanPatricioSliders);
    });
}

/* Load the cross-origin StoryMap only after its section is visible.
   This avoids initializing it in a hidden panel and, importantly, avoids
   removing/re-adding its URL, which can retrigger browser permission prompts. */
function loadStoryMapOnce() {
    const storyMapFrame = document.querySelector('#storymap-container iframe');
    if (!storyMapFrame || storyMapFrame.dataset.loaded === 'true') return;

    const source = storyMapFrame.dataset.src;
    if (!source) return;

    storyMapFrame.dataset.loaded = 'true';
    storyMapFrame.setAttribute('src', source);
}

document.addEventListener('DOMContentLoaded', () => {
    initializeJuanPatricioSliders();

    document.querySelectorAll('.nav-group a[href^="#"]').forEach(link => {
        link.addEventListener('click', () => {
            window.setTimeout(updateActiveNav, 40);
        });
    });
});

window.addEventListener('resize', () => {
    updateJuanPatricioSliders();
    updateActiveNav();
});
